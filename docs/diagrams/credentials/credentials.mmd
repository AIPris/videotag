%% src: videotag/credentials.py videotag/admin.py
%% legend: blue=every run; green=one-time setup
flowchart TD
  subgraph SETUP [One-time setup]
    S1[credentials set<br/>typed in a terminal] --> S2[verify with a real login]
    S2 --> S3[store in the OS vault]
  end
  subgraph RUN [Every run]
    A([load_credentials]) --> B{VIDEOTAG_ variables<br/>or their _FILE variants set?}
    B -->|yes| C[use the environment]
    B -->|no| D{login in the OS vault?}
    D -->|yes| E[use the credential store]
    D -->|no| F([error: run credentials set])
  end
  S3 -.-> D
  class S1,S2,S3 green
  class A,B,C,D,E,F blue
